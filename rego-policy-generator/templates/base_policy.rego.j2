package crowdstrike

# {{ title }}
# Framework: {{ framework }}
# Control ID: {{ control_id }}
# Severity: {{ severity }}
# Description: {{ description }}

default result := "fail"

# Skip non-{{ resource_type }} resources
result = "skip" if {
    input.resource_type != "{{ resource_type }}"
}

# Pass if {{ pass_condition }}
result = "pass" if {
    input.resource_type == "{{ resource_type }}"
    input.configuration.{{ config_path }}
    {% if negate_condition %}not {% endif %}{{ helper_function }}
}

{% if helper_function %}
# Helper rule for {{ helper_description }}
{{ helper_function }} {
    {% for condition in conditions %}
    {{ condition }}
    {% endfor %}
}
{% endif %}

{% for helper in additional_helpers %}
# {{ helper.description }}
{{ helper.name }} {
    {% for condition in helper.conditions %}
    {{ condition }}
    {% endfor %}
}
{% endfor %}